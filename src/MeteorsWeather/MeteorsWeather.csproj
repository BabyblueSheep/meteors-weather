<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
		<TargetFramework>netstandard2.1</TargetFramework>
        <AssemblyName>net.babybluesheep.MeteorsWeather</AssemblyName>
		<AssemblyTitle>Meteor Showers as a Weather</AssemblyTitle>
        <Version>1.0.0</Version>
    </PropertyGroup>

    <!-- Mod files to copy to the relative BepInEx directory after build -->
    <ItemGroup>
        <DeployModFiles Include="$(TargetPath)" BepInExDir="plugins/" />
    </ItemGroup>
	
	<ItemGroup>
		<Content Include="resources\**\*">
			<Link>resources\%(RecursiveDir)%(Filename)%(Extension)</Link>
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</Content>
	</ItemGroup>
</Project>